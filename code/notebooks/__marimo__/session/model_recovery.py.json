          "type": "data",
          "data": {
            "text/markdown": "<span class=\"markdown prose dark:prose-invert contents\"><h1 id=\"glm-hmm-model-recovery\">GLM-HMM Model Recovery</h1>\n<span class=\"paragraph\">This notebook now uses the task adapters and <code>SubjectFitView</code> pipeline.</span>\n<span class=\"paragraph\">Workflow:</span>\n<ol>\n<li>Choose a task, subject, and regressors</li>\n<li>Reuse that subject's real covariates and session structure</li>\n<li>Simulate synthetic choices from user-defined ground-truth GLM-HMM parameters</li>\n<li>Fit the same model family back to the synthetic data</li>\n<li>Compare true vs fitted states, posteriors, weights, and transitions</li>\n</ol></span>"
          }
        }
      ],
      "console": []
    },
